{
  "name": "reb-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "eve build",
    "dev": "eve dev",
    "start": "eve start",
    "typecheck": "tsc",
    "gateway": "node --env-file=.env.local gateway/index.ts",
    "register": "node --env-file=.env --import tsx/esm --input-type=module -e 'import { registerCommands } from \"./bot/register.ts\"; await registerCommands();'"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "ai": "^7.0.148",
    "discord-interactions": "^4.4.0",
    "discord.js": "^14.27.0",
    "eve": "^0.82.0",
    "minecraft-server-util": "^5.4.4",
    "table": "^6.9.0",
    "yahoo-finance2": "^4.0.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
